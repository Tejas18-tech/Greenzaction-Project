# Flask API
FLASK_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret

# MongoDB is optional for local demo mode; set this to use MongoDB persistence.
MONGODB_URI=mongodb://127.0.0.1:27017
db_name=greenzaction

# Optional external AI provider. If omitted, deterministic recommendation/chat fallbacks are used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional browser-safe API base for a separately hosted frontend.
VITE_API_BASE=
